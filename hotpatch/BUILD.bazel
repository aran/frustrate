load("@platforms//host:constraints.bzl", "HOST_CONSTRAINTS")
load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_test")
load("//bazel:hot_patch.bzl", "frustrate_rust_llc")

rust_library(
    name = "frustrate_hotpatch_lib",
    srcs = glob(
        ["src/**/*.rs"],
        exclude = ["src/main.rs"],
    ),
    crate_name = "frustrate_hotpatch",
    edition = "2021",
    visibility = ["//tests/hotpatch:__pkg__"],
    deps = [
        "@frustrate_crates//:object",
        "@frustrate_crates//:rustc-demangle",
        "@frustrate_crates//:serde_json",
    ],
)

rust_binary(
    name = "frustrate_hotpatch",
    srcs = ["src/main.rs"],
    edition = "2021",
    visibility = ["//visibility:public"],
    deps = [
        ":frustrate_hotpatch_lib",
        "@frustrate_crates//:serde_json",
    ],
)

rust_test(
    name = "frustrate_hotpatch_test",
    crate = ":frustrate_hotpatch_lib",
    edition = "2021",
)

# The `llc` a patch is compiled with, from the Rust toolchain that targets the
# patched library's platform. A constraint, not a transition: `llc` is a file
# the toolchain downloads, not a program Bazel builds, and it runs on the
# developer's machine, so the toolchain must be one whose execution side is a
# machine like this one. Any platform with these constraints, local or remote,
# resolves the same file.
frustrate_rust_llc(
    name = "llc",
    exec_compatible_with = HOST_CONSTRAINTS,
    visibility = ["//visibility:public"],
)
