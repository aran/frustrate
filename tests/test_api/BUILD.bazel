load("@rules_dart//dart:defs.bzl", "dart_library", "dart_package_metadata", "dart_test")
load("@rules_rust//rust:defs.bzl", "rust_shared_library")
load("//bazel:defs.bzl", "frustrate_bridge_outputs", "frustrate_code_asset", "frustrate_no_block_check", "frustrate_wasm_module")
load("//bazel:idle_barrier.bzl", "frustrate_idle_barrier_library")
load("//bazel:manual_scheduler.bzl", "frustrate_manual_scheduler_library")

# Read by //tools/shape_coverage:shape_coverage_test, which checks the fixture
# against what its generator writes today.
exports_files([
    "src/api.rs",
    "src/cancel_api.rs",
    "src/shapes.rs",
    "src/shapes_reclaim.rs",
])

frustrate_bridge_outputs(
    name = "bridge",
    package_name = "frustrate_integration",
    srcs = [
        "src/api.rs",
        "src/cancel_api.rs",
        "src/shapes.rs",
    ],
    crate_name = "test_api",
    module_paths = [
        "crate::api",
        "crate::cancel_api",
        "crate::shapes",
    ],
    visibility = ["//tests:__subpackages__"],
)

# Every `no_block` claim here, over the native build: test_api ships native,
# and its web build is single-threaded.
frustrate_no_block_check(
    name = "test_api_block_check",
    # A probe logs through the logger the logging fixture installs, and a
    # callback probe drops a waker an awaiting task left in the invocation
    # registry: both callbacks installed elsewhere, and this fixture's to
    # accept.
    allow = [
        "core::task::wake::Waker::drop",
        "log::__private_api::GlobalLogger::log",
    ],
    bridge = ":bridge",
    crate = ":test_api_shared",
    targets = [
        "android",
        "ios",
        "linux",
        "macos",
        "web",
        "web_threads",
    ],
)

dart_test(
    name = "block_check_coverage_test",
    data = [":bridge.claims"],
    main = "block_check_coverage_test.dart",
    deps = [
        "@pub_deps//:test",
        "@rules_dart//dart/runfiles",
    ],
)

filegroup(
    name = "bridge.claims",
    srcs = [":bridge"],
    output_group = "claims",
)

rust_shared_library(
    name = "test_api_shared",
    srcs = [
        "src/api.rs",
        "src/cancel_api.rs",
        "src/lib.rs",
        "src/shapes.rs",
        ":bridge.rs",
    ],
    # The std-facility probes (api.rs, "the standard library on web") need to
    # know whether the std being linked has its stubs replaced, and the target
    # cannot tell them apart: stock and patched are both wasm32-unknown-unknown.
    # Deriving the feature from the constraints the toolchain resolves on
    # means a module built against a facility std always has it, and one built
    # against the stock or the +atomics std never does.
    crate_features = select({
        "//bazel:wasm_facility_std_build": ["wasm-std-facilities"],
        "//conditions:default": [],
    }),
    edition = "2021",
    proc_macro_deps = ["//macros:frustrate_macros"],
    visibility = [
        "//tests:__subpackages__",
        "//tools:__pkg__",
    ],
    deps = [
        "//runtime/rust:frustrate",
        "@frustrate_crates//:anyhow",
        # The logging fixture logs through the ordinary facade, exactly as a
        # dependency that has never heard of frustrate would.
        "@frustrate_crates//:log",
        # The bring-your-own-runtime worked example's external executor;
        # wasm-safe, so the web fixture is unaffected.
        "@frustrate_crates//:pollster",
    ],
)

# The bridge library as the code asset the bindings resolve it by.
frustrate_code_asset(
    name = "test_api_asset",
    bridge = ":bridge",
    library = ":test_api_shared",
    visibility = ["//tests:__subpackages__"],
)

# The same library built with the manual scheduler, bound to the same asset id
# as `test_api_asset`: a test takes it with `code_assets`, which replaces that one.
frustrate_manual_scheduler_library(
    name = "test_api_manual",
    library = ":test_api_shared",
)

frustrate_code_asset(
    name = "test_api_manual_asset",
    bridge = ":bridge",
    library = ":test_api_manual",
    visibility = ["//tests/dart_integration:__pkg__"],
)

# The same library built with the idle barrier, bound to the same asset id as
# `test_api_asset`, taken the same way.
frustrate_idle_barrier_library(
    name = "test_api_idle",
    library = ":test_api_shared",
)

frustrate_code_asset(
    name = "test_api_idle_asset",
    bridge = ":bridge",
    library = ":test_api_idle",
    visibility = ["//tests/dart_integration:__pkg__"],
)

# The browser fixture: same crate, stable Rust, single-threaded wasm.
# `bazel run //tests/dart_integration:web_test` serves it.
frustrate_wasm_module(
    name = "test_api.wasm",
    crate = ":test_api_shared",
    visibility = ["//tests:__subpackages__"],
)

# The threaded-wasm fixture: nightly + locally built +atomics std (run `bazel
# run //toolchain/custom_std:build` first). Tagged manual so wildcard builds
# stay green without the local artifacts.
frustrate_wasm_module(
    name = "test_api_threaded.wasm",
    crate = ":test_api_shared",
    platform = "//bazel:wasm32_threads",
    tags = ["manual"],
    visibility = ["//tests:__subpackages__"],
)

# The facility-std fixture: single-threaded, linked against a std whose stubs
# ask the host for a clock, entropy, console stdio, available_parallelism and
# sleep (run `bazel run //toolchain/custom_std:build --
# --facilities=clock,random,stdio,thread` first). Tagged manual for the same
# reason as the threaded one.
frustrate_wasm_module(
    name = "test_api_facilities.wasm",
    crate = ":test_api_shared",
    platform = "//bazel:wasm32_custom",
    tags = ["manual"],
    visibility = ["//tests:__subpackages__"],
)

# The extern-type fixture's Dart class: one source of truth (the pub
# package's lib/, where the cargo flow needs it), copied into this package
# so the bindings dart_library serves it under the same package URI.
genrule(
    name = "fake_plan_dart",
    srcs = ["//tests/dart_integration:lib/fake_plan.dart"],
    outs = ["lib/fake_plan.dart"],
    cmd = "cp $< $@",
)

# Same package URI as the cargo flow (tests/dart_integration/pubspec.yaml
# names the package frustrate_integration), so one import works in both.
dart_package_metadata(
    name = "pubspec-metadata",
    package_name = "frustrate_integration",
    code_assets = [":test_api_asset"],
)

dart_library(
    name = "bindings",
    srcs = [
        ":bridge.dart",
        ":fake_plan_dart",
    ],
    package = ":pubspec-metadata",
    visibility = ["//tests:__subpackages__"],
    deps = [
        "//runtime/dart:frustrate",
        "@pub_deps//:ffi",
    ],
)
