load("@rules_dart//dart:defs.bzl", "dart_library", "dart_package_metadata")
load("//bazel:defs.bzl", "frustrate_bridge", "frustrate_bridge_library", "frustrate_code_asset")

frustrate_bridge(
    name = "bridge",
    package_name = "models_a",
    # Pairs with `module_paths`, by position.
    srcs = [
        # do not sort
        "//tests/models/shared:src/model.rs",
        "src/api.rs",
    ],
    crate_name = "models_a",
    data_package_name = "models_a_data",
    module_paths = [
        "models_shared::model",
        "crate::api",
    ],
    visibility = ["//tests/models:__subpackages__"],
)

frustrate_bridge_library(
    name = "models_a",
    srcs = [
        "src/api.rs",
        "src/lib.rs",
        ":bridge.rs",
    ],
    edition = "2021",
    proc_macro_deps = ["//macros:frustrate_macros"],
    visibility = ["//tests/models:__subpackages__"],
    deps = [
        "//runtime/rust:frustrate",
        "//tests/models/shared:models_shared",
    ],
)

frustrate_code_asset(
    name = "asset",
    bridge = ":bridge",
    library = ":models_a",
    visibility = ["//tests/models:__subpackages__"],
)

dart_package_metadata(
    name = "pubspec-metadata",
    package_name = "models_a",
)

dart_library(
    name = "bindings",
    srcs = [":bridge.dart"],
    package = ":pubspec-metadata",
    visibility = ["//tests/models:__subpackages__"],
    deps = [
        "//runtime/dart:frustrate",
        "//tests/models/a_data:data",
    ],
)
