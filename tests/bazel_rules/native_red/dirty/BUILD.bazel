load("@rules_rust//rust:defs.bzl", "rust_shared_library")
load("//bazel:defs.bzl", "frustrate_bridge_outputs")
load("//bazel:no_block_check.bzl", "no_block_check_artifacts")

# A claimed member that takes a clean bounded-lock section, in a build where
# another section of the same lock type sleeps. See ../BUILD.bazel.

frustrate_bridge_outputs(
    name = "bridge",
    srcs = ["src/api.rs"],
    crate_name = "native_red_dirty",
    package_name = "native_red_dirty",
    module_paths = ["crate::api"],
)

rust_shared_library(
    name = "dirty_shared",
    srcs = [
        "src/api.rs",
        "src/lib.rs",
        ":bridge.rs",
    ],
    crate_name = "native_red_dirty",
    edition = "2021",
    proc_macro_deps = ["//macros:frustrate_macros"],
    deps = ["//runtime/rust:frustrate"],
)

no_block_check_artifacts(
    name = "artifacts",
    bridge = ":bridge",
    # Compiles runtime/rust/src/bounded.rs's sleeping fixture section.
    cfgs = ["frustrate_dirty_section_fixture"],
    crate = ":dirty_shared",
    platforms = [
        "//bazel:android_aarch64",
        "//bazel:android_x86_64",
        "//bazel:ios_aarch64",
        "//bazel:linux_aarch64",
        "//bazel:linux_x86_64",
        "//bazel:macos_aarch64",
    ],
    visibility = [
        "//bazel/wasm_block_check:__pkg__",
        "//tests/bazel_rules/native_red:__pkg__",
    ],
)
