load("@rules_cc//cc:defs.bzl", "cc_library")
load("@rules_rust//rust:defs.bzl", "rust_shared_library")
load("//bazel:defs.bzl", "frustrate_bridge")
load("//bazel:no_block_check.bzl", "no_block_check_artifacts")

# A claimed member that calls a C function. See ../BUILD.bazel.

frustrate_bridge(
    name = "bridge",
    package_name = "native_red_external",
    srcs = ["src/api.rs"],
    crate_name = "native_red_external",
    module_paths = ["crate::api"],
)

cc_library(
    name = "step",
    srcs = ["src/step.c"],
)

rust_shared_library(
    name = "external_shared",
    srcs = [
        "src/api.rs",
        "src/lib.rs",
        ":bridge.rs",
    ],
    crate_name = "native_red_external",
    edition = "2021",
    link_deps = [":step"],
    proc_macro_deps = ["//macros:frustrate_macros"],
    deps = ["//runtime/rust:frustrate"],
)

no_block_check_artifacts(
    name = "artifacts",
    bridge = ":bridge",
    library = ":external_shared",
    platforms = [
        "//bazel:linux_aarch64",
        "//bazel:linux_x86_64",
        "//bazel:macos_aarch64",
    ],
    # Its macOS build compiles C with Xcode, which only a Mac has; native_red_test
    # runs only there too.
    target_compatible_with = select({
        "@platforms//os:macos": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    visibility = ["//tests/bazel_rules/native_red:__pkg__"],
)
