load("@rules_rust//rust:defs.bzl", "rust_shared_library")
load("//bazel:defs.bzl", "frustrate_bridge_outputs")
load("//bazel:no_block_check.bzl", "no_block_check_artifacts")

# A claimed member that waits, in a crate whose own flags raise the opt-level
# past the check's pin. See ../BUILD.bazel.

frustrate_bridge_outputs(
    name = "bridge",
    srcs = ["src/api.rs"],
    crate_name = "native_red_optimized",
    package_name = "native_red_optimized",
    module_paths = ["crate::api"],
)

rust_shared_library(
    name = "optimized_shared",
    srcs = [
        "src/api.rs",
        "src/lib.rs",
        ":bridge.rs",
    ],
    crate_name = "native_red_optimized",
    edition = "2021",
    proc_macro_deps = ["//macros:frustrate_macros"],
    rustc_flags = ["-Copt-level=2"],
    deps = ["//runtime/rust:frustrate"],
)

no_block_check_artifacts(
    name = "artifacts",
    bridge = ":bridge",
    crate = ":optimized_shared",
    platforms = [
        "//bazel:android_aarch64",
        "//bazel:android_x86_64",
        "//bazel:ios_aarch64",
        "//bazel:linux_aarch64",
        "//bazel:linux_x86_64",
        "//bazel:macos_aarch64",
    ],
    visibility = [
        "//bazel/wasm_block_check:__pkg__",
        "//tests/bazel_rules/native_red:__pkg__",
    ],
)
