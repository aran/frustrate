load("@rules_rust//rust:defs.bzl", "rust_shared_library")
load("//bazel:defs.bzl", "frustrate_bridge")
load("//bazel:no_block_check.bzl", "no_block_check_artifacts")

# A claimed member that searches bytes with memchr, which picks its routine
# at run time on x86_64. See ../BUILD.bazel.

frustrate_bridge(
    name = "bridge",
    package_name = "native_red_memchr",
    srcs = ["src/api.rs"],
    crate_name = "native_red_memchr",
    module_paths = ["crate::api"],
)

rust_shared_library(
    name = "memchr_shared",
    srcs = [
        "src/api.rs",
        "src/lib.rs",
        ":bridge.rs",
    ],
    crate_name = "native_red_memchr",
    edition = "2021",
    proc_macro_deps = ["//macros:frustrate_macros"],
    deps = [
        "//runtime/rust:frustrate",
        "@native_red_crates//:memchr",
    ],
)

no_block_check_artifacts(
    name = "artifacts",
    bridge = ":bridge",
    library = ":memchr_shared",
    platforms = [
        "//bazel:android_aarch64",
        "//bazel:android_x86_64",
        "//bazel:linux_aarch64",
        "//bazel:linux_x86_64",
    ],
    visibility = ["//tests/bazel_rules/native_red:__pkg__"],
)
