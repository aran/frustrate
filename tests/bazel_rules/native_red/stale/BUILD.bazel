load("@rules_rust//rust:defs.bzl", "rust_shared_library")
load("//bazel:defs.bzl", "frustrate_bridge_outputs")
load("//bazel:no_block_check.bzl", "no_block_check_artifacts")

# A claimed member carrying a silence that silences nothing. See ../BUILD.bazel.

frustrate_bridge_outputs(
    name = "bridge",
    srcs = ["src/api.rs"],
    crate_name = "native_red_stale",
    package_name = "native_red_stale",
    module_paths = ["crate::api"],
)

rust_shared_library(
    name = "stale_shared",
    srcs = [
        "src/api.rs",
        "src/lib.rs",
        ":bridge.rs",
    ],
    crate_name = "native_red_stale",
    edition = "2021",
    proc_macro_deps = ["//macros:frustrate_macros"],
    deps = [
        "//runtime/rust:frustrate",
    ],
)

no_block_check_artifacts(
    name = "artifacts",
    bridge = ":bridge",
    crate = ":stale_shared",
    platforms = ["//bazel:macos_aarch64"],
    visibility = ["//tests/bazel_rules/native_red:__pkg__"],
)
