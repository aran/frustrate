frustrate_bridge_library(
    name = "app",
    srcs = [
        "src/api.rs",
        "src/lib.rs",
        ":bridge.rs",
    ],
    crate_name = "linked_app",
    edition = "2021",
    proc_macro_deps = ["//macros:frustrate_macros"],
    shared_library = False,
    visibility = ["//tests/bazel_rules:__subpackages__"],
    deps = ["//runtime/rust:frustrate"],
)
