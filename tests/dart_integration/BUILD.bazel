    name = "callback_liveness_test",
    timeout = "short",
    data = ["//tests/test_api:test_api_shared"],
    main = "test/callback_liveness_test.dart",
    srcs = ["test/init_native.dart"],
    deps = [
        "//tests/test_api:bindings",
        "//runtime/dart:frustrate",
        "@pub_deps//:test",
        "@rules_dart//dart/runfiles",
    ],
)

# VM-only: the AWAITED twin. An `async fn` awaiting a `DartFunction` whose
# owning isolate accepted the invocation and then died must still settle — the
# executor task must not leak, the enclosing bridge call must complete, and the
# caller isolate's `keepIsolateAlive` must unlatch so it can exit.
#
# Red from 2026-07-29 to 2026-07-30 as the pin for that defect; green since the
# isolate started reporting its own death (post::handle_exit). Its two siblings
# are the discriminators that stop a cheap fix passing: the slow-but-alive
# negative, and the assertion that parked awaited calls hold no pool worker.
#
# Separate target from `callback_liveness_test` above: one parked awaited call
# latches whichever isolate made it, so a regression here sharing that file
# would drag its three tests into an empty-log TIMEOUT. `timeout = "short"` for
# the same reason as its sibling — the natural signature of this family is a
# hang, and it must never be able to wedge another suite.
dart_test(
    name = "callback_async_liveness_test",
    timeout = "short",
    data = ["//tests/test_api:test_api_shared"],
    main = "test/callback_async_liveness_test.dart",
    srcs = ["test/init_native.dart"],
    deps = [
        "//tests/test_api:bindings",
        "//runtime/dart:frustrate",
        "@pub_deps//:test",
        "@rules_dart//dart/runfiles",
    ],
)

