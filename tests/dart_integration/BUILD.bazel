# The extern-type fixture's Dart side (a stand-in for a protoc-generated
# class). Lives here so the cargo/pub flow finds it under this package's
# lib/; the Bazel bindings package copies it in (//tests/test_api).
exports_files(["lib/fake_plan.dart"])

# The browser (dart2wasm + Chrome) side of the suite — including the decisive
# single-threaded-web "1000 concurrent async fn calls multiplex on one thread"
# test. rules_dart's dart_test is VM-only (no browser launcher) and a Chrome
# run is not hermetic, so this cannot be a `bazel test` target; it is a Dart
# driver (never a shell script) run via `bazel run`:
#   bazel run //tests/dart_integration:web_test                 # single-threaded
#   bazel run //tests/dart_integration:web_test -- --threaded   # threaded wasm
# It builds the wasm fixture, then runs `dart test -p chrome -c dart2wasm`.
dart_binary(
    name = "web_test",
    main = "tool/web_test.dart",
)

# The native (dylib/FFI) benchmark. A `dart_binary` for the reason that makes
# it a benchmark at all: rules_dart defaults `compile_mode = "exe"`, so this is
# AOT with asserts off, unlike `dart_test` (which the runner spawns
# `checked: true` — JIT, asserts on).
#
#   bazel run //tests/dart_integration:native_bench
#
# It deliberately does NOT depend on //tests/test_api:test_api_shared. That
# artifact is built at the invocation's --compilation_mode, and Bazel's default
# `fastbuild` is -Copt-level=0 under rules_rust (opt levels are
# {dbg: 0, fastbuild: 0, opt: 3}) — so depending on it would mean a plain
# `bazel run` silently benchmarked unoptimized Rust. The driver runs
# `cargo build --release -p test_api` itself and loads the path cargo reports.
#
# Not a `bazel test` target and asserts nothing about absolute time: an
# absolute-timing bar in CI is a separate decision, to be made against the
# numbers this produces.
dart_binary(
    name = "native_bench",
    main = "tool/native_bench.dart",
    # The harness (Cell, the calibrate/warmup/measure loop, the table renderer)
    # is //tools/bench_harness, shared verbatim with the in-page web bench.
    # It used to be `tool/bench_core.dart` listed in `srcs` here — which said
    # in its own comment that it existed so the web bench would not grow "a
    # second copy that drifts", and a byte-identical copy grew anyway in
    # another package, because a `srcs` entry cannot cross a pub package
    # boundary. A dep can, and cannot be satisfied by copying.
    deps = [
        "//runtime/dart:frustrate",
        "//tests/test_api:bindings",
        "//tools/bench_harness",
    ],
)

# The release (-O2) web benchmark — the vehicle the browser suite cannot be.
#
#   bazel run //tests/dart_integration:web_bench                 # single-threaded
#   bazel run //tests/dart_integration:web_bench -- --threaded   # threaded wasm
#
# `bazel run`, not `bazel test`, for three independent reasons, any one of
# which would be sufficient:
#
#  - It drives system Chrome, which is not hermetic under Bazel — the same
#    reason `web_test` above is a `bazel run`.
#  - It owns both compiler invocations (`dart compile wasm -O2` for the Dart
#    half, `cargo --release` via build_web_fixture for the Rust half) rather
#    than depending on Bazel-built artifacts, because a Bazel target's
#    optimization level silently follows `--compilation_mode` and the default
#    `fastbuild` is unoptimized. A benchmark that cannot name its own build
#    config is worse than no benchmark; see the driver's header.
#  - It is a measurement instrument, and it asserts nothing about absolute
#    time. Perf gates do not belong in CI, so this must not be able to fail a
#    test run.
#
# `dart_binary` is `rule(..., executable = True)` with no `test = True`, so it
# is not collected by `bazel test //...` and nothing new enters the default
# suite by adding it. No deps: the driver is dart:io only, and the code it
# measures is compiled from the source tree by the compilers it invokes.
dart_binary(
    name = "web_bench",
    main = "tool/web_bench.dart",
)

