load("@rules_dart//dart:defs.bzl", "dart_library", "dart_package_metadata")
load("//bazel:defs.bzl", "frustrate_bridge_library", "frustrate_bridge_outputs")

frustrate_bridge_outputs(
    name = "bridge",
    package_name = "compose_beta",
    srcs = ["src/api.rs"],
    crate_name = "compose_beta",
    module_paths = ["crate::api"],
    visibility = ["//tests:__subpackages__"],
)

frustrate_bridge_library(
    name = "beta",
    srcs = [
        "src/api.rs",
        "src/lib.rs",
        ":bridge.rs",
    ],
    crate_name = "compose_beta",
    edition = "2021",
    proc_macro_deps = ["//macros:frustrate_macros"],
    # Beta only ever ships inside //tests/compose:composed.
    shared_library = False,
    visibility = ["//tests:__subpackages__"],
    deps = [
        "//runtime/rust:frustrate",
        "//tests/compose/shared",
    ],
)

dart_package_metadata(
    name = "pubspec-metadata",
    package_name = "compose_beta",
)

dart_library(
    name = "bindings",
    srcs = [":bridge.dart"],
    package = ":pubspec-metadata",
    visibility = ["//tests:__subpackages__"],
    deps = [
        "//runtime/dart:frustrate",
        "@pub_deps//:ffi",
    ],
)
