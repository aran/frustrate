"""The wasi demo: a Flutter app whose Rust bridge needs a working `std`.

Separate from e2e/flutter_demo on purpose: folding this crate's uuid-and-clock
members into that app's bridge would move it off plain
`wasm32-unknown-unknown`, which is the platform it exists to cover.
"""

module(name = "frustrate_wasi_demo")

bazel_dep(name = "frustrate", version = "0.1.0")
bazel_dep(name = "rules_flutter", version = "0.0.8")
bazel_dep(name = "rules_dart", version = "0.9.1")
bazel_dep(name = "rules_rust", version = "0.75.0")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "bazel_skylib", version = "1.9.2")
bazel_dep(name = "apple_support", version = "2.12.0")
bazel_dep(name = "rules_apple", version = "5.4.0")
bazel_dep(name = "rules_cc", version = "0.2.28")
bazel_dep(name = "rules_swift", version = "4.2.2")

# `wasm32-unknown-unknown` is deliberately ABSENT: it is in rules_rust's default
# triple set, and naming any triple here replaces that default. This app's
# bridge crate does not compile for it, so leaving it out makes a `platform =`
# typo pointing back at the default platform fail at analysis.
rust = use_extension("@rules_rust//rust:extensions.bzl", "rust")
rust.toolchain(
    edition = "2021",
    extra_target_triples = ["wasm32-wasip1"],
    versions = ["1.99.1"],
)

# The demos live inside frustrate's tree and build against it.
local_path_override(
    module_name = "frustrate",
    path = "../..",
)

# The bridge crate's cargo dependencies. A hub of this module's own: frustrate's
# `@frustrate_crates` resolves frustrate's own manifests and hub repos are not re-exported
# to consumers, so this module declares its own.
#
# Nothing checks that this triple list and `extra_target_triples` above agree.
# The per-platform build_tests in //:BUILD.bazel are what turn a disagreement
# into a red target.
crate = use_extension("@rules_rust//crate_universe:extensions.bzl", "crate")
crate.from_cargo(
    name = "wasi_crates",
    cargo_lockfile = "//bridge:Cargo.lock",
    manifests = ["//bridge:Cargo.toml"],
    supported_platform_triples = [
        # web, the point of this example:
        "wasm32-wasip1",
        # the macOS host build:
        "aarch64-apple-darwin",
        "x86_64-apple-darwin",
    ],
)
use_repo(crate, "wasi_crates")

flutter = use_extension("@rules_flutter//flutter:extensions.bzl", "flutter")
flutter.toolchain(flutter_version = "3.47.9")
use_repo(flutter, "flutter_toolchains", "flutter_web_sdk")

flutter_pub = use_extension("@rules_flutter//flutter/pub:extensions.bzl", "pub")
flutter_pub.from_lock(
    name = "deps",
    lock = "//:pubspec.lock",
)
use_repo(flutter_pub, "deps", "dev_tool_deps")
