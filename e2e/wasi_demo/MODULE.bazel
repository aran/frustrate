# The demos live inside frustrate's tree and build against it.
local_path_override(
    module_name = "frustrate",
    path = "../..",
)

# The bridge crate's cargo dependencies. A hub of this module's own: frustrate's
# `@crates` resolves frustrate's own manifests and hub repos are not re-exported
# to consumers, so the name here must NOT be "crates".
#
# Nothing checks that this triple list and `extra_target_triples` above agree.
# The per-platform build_tests in //:BUILD.bazel are what turn a disagreement
# into a red target.
crate = use_extension("@rules_rust//crate_universe:extensions.bzl", "crate")
crate.from_cargo(
    name = "wasi_crates",
    cargo_lockfile = "//bridge:Cargo.lock",
    manifests = ["//bridge:Cargo.toml"],
    supported_platform_triples = [
        # web, the point of this example:
        "wasm32-wasip1",
        # the macOS host build:
        "aarch64-apple-darwin",
        "x86_64-apple-darwin",
    ],
)
use_repo(crate, "wasi_crates")

flutter = use_extension("@rules_flutter//flutter:extensions.bzl", "flutter")
flutter.toolchain(flutter_version = "3.47.5")
flutter.pub(
    name = "deps",
    lock = "//:pubspec.lock",
)
use_repo(flutter, "deps", "dev_tool_deps", "flutter_macos_engine", "flutter_toolchains", "flutter_web_sdk")

register_toolchains("@flutter_toolchains//:all")
