# Written by `bazel run @rules_flutter//flutter:pub -- get`, which regenerates
# each platform's ephemeral tooling as a side effect. That target exists to give
# the *editor* a package_config.json; the Bazel build templates its own runners
# and reads none of this. (ios/.gitignore already covers the iOS equivalent;
# macOS has no such file of its own.)
/macos/Flutter/ephemeral/
.flutter-plugins-dependencies
