load("@frustrate//bazel:defs.bzl", "frustrate_bridge", "frustrate_bridge_library")
load("@rules_dart//dart:defs.bzl", "dart_package_metadata")
load("@rules_flutter//flutter:defs.bzl", "flutter_plugin")

frustrate_bridge(
    name = "codegen",
    package_name = "compose_pong",
    srcs = ["src/api.rs"],
    crate_name = "compose_pong",
    module_paths = ["crate::api"],
    visibility = ["//compose:__pkg__"],
)

frustrate_bridge_library(
    name = "pong",
    srcs = [
        "src/api.rs",
        "src/lib.rs",
        ":codegen.rs",
    ],
    crate_name = "compose_pong",
    edition = "2021",
    proc_macro_deps = ["@frustrate//macros:frustrate_macros"],
    visibility = ["//compose:__pkg__"],
    deps = ["@frustrate//runtime/rust:frustrate"],
)

dart_package_metadata(
    name = "pubspec-metadata",
    package_name = "compose_pong",
)

# The bindings alone: the app names the library that serves them in its
# `code_assets` (//compose:BUILD.bazel).
flutter_plugin(
    name = "bindings",
    srcs = [":codegen.dart"],
    package = ":pubspec-metadata",
    platforms = [
        "macos",
        "ios",
        "android",
    ],
    visibility = ["//compose:__pkg__"],
    deps = ["@frustrate//runtime/dart:frustrate"],
)
