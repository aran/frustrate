"""The frustrate Flutter demo: one portable app, Rust under the UI, on macOS,
web, iOS, Android, and Linux. Consumes rules_flutter strictly through its public
seams.

Android is opt-in: `--config=android` (see .bazelrc) is what registers the SDK
and NDK toolchains, so every other build needs no Android setup."""

module(name = "frustrate_flutter_demo")

bazel_dep(name = "frustrate", version = "0.1.0")
bazel_dep(name = "rules_flutter", version = "0.0.8")
bazel_dep(name = "rules_dart", version = "0.8.1")
bazel_dep(name = "rules_rust", version = "0.75.0")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "bazel_skylib", version = "1.9.2")
bazel_dep(name = "apple_support", version = "2.12.0")
bazel_dep(name = "rules_apple", version = "5.4.0")
bazel_dep(name = "rules_cc", version = "0.2.28")
bazel_dep(name = "rules_swift", version = "4.2.2")

# Android bundling (rules_flutter's flutter_android_app + the NDK cc toolchain
# that cross-compiles the Rust bridge to android_arm64).
bazel_dep(name = "rules_android", version = "0.8.1")
bazel_dep(name = "rules_android_ndk", version = "0.1.5")
bazel_dep(name = "rules_kotlin", version = "2.4.21")
bazel_dep(name = "rules_java", version = "9.9.0")
bazel_dep(name = "rules_go", version = "0.64.2")
bazel_dep(name = "rules_jvm_external", version = "7.2")

# Pinned to a commit, not a release: 0.1.5 hardcodes
# `-Wl,-z,max-page-size=4096` in its toolchain, so every Android .so links
# 4KB-aligned. A device running 16KB pages then refuses to load them: "ELF
# alignment check failed". Nothing surfaces at build time;
# the APK builds, installs, and dies on launch, which is why a green build
# is not evidence here.
#
# The pinned commit uses 16384 for both max- and common-page-size across
# all link actions. Fixing it in the toolchain rather than per-target also
# covers native libraries this module does not own.
archive_override(
    module_name = "rules_android_ndk",
    sha256 = "420b58372108f974979ff7417959d1409b90bc6d70677e17da005844f4eb8d54",
    strip_prefix = "rules_android_ndk-8ba0720dcf044fc1cdd82ca8160df0dd394f8711",
    urls = ["https://github.com/bazelbuild/rules_android_ndk/archive/8ba0720dcf044fc1cdd82ca8160df0dd394f8711.tar.gz"],
)

# This app bundles the Rust bridge for every platform it targets, so it
# declares the cross-compile triples here: the app module is the root of its
# own build, and a dependency's (frustrate's) toolchain config does not
# propagate. `extra_target_triples` replaces the rules_rust default, so the
# web target (wasm32-unknown-unknown) is re-listed alongside the app targets.
# frustrate already registers `@rust_toolchains//:all`, so no register call is
# needed here (and omitting it keeps the threaded-wasm toolchain ordering).
rust = use_extension("@rules_rust//rust:extensions.bzl", "rust")
rust.toolchain(
    edition = "2021",
    extra_target_triples = [
        "wasm32-unknown-unknown",
        "aarch64-apple-ios",
        "aarch64-apple-ios-sim",
        "aarch64-linux-android",
        "x86_64-linux-android",
        "x86_64-unknown-linux-gnu",
    ],
    versions = ["1.99.1"],
)

# The demos live inside frustrate's tree and build against it.
local_path_override(
    module_name = "frustrate",
    path = "../..",
)

flutter = use_extension("@rules_flutter//flutter:extensions.bzl", "flutter")
flutter.toolchain(flutter_version = "3.47.9")
use_repo(flutter, "flutter_android_engine_arm64", "flutter_toolchains", "flutter_web_sdk")

flutter_pub = use_extension("@rules_flutter//flutter/pub:extensions.bzl", "pub")
flutter_pub.from_lock(
    name = "deps",
    lock = "//:pubspec.lock",
    resolve = {
        "demo_bridge": "//bridge:demo_bridge",
        "frustrate": "@frustrate//runtime/dart:frustrate",
    },
)
use_repo(flutter_pub, "deps", "dev_tool_deps")

# The bridge crate's one cargo dependency: the `log` facade its `log::info!`
# calls expand against, and therefore the one whose logger slot
# `frustrate::logging::set_sink` has to fill.
#
# It is resolved *here*, in the app's own hub, rather than borrowed from
# frustrate. That is what makes the facility work: `log`'s logger is a `static`
# per rlib, every hub resolves a `log` of its own, and an app's dependencies
# link the app's hub — so the only wiring that delivers anything is the one
# where frustrate's runtime compiles against this same rlib. `.bazelrc` points
# frustrate's `log` build setting at it.
#
# `from_specs` rather than `from_cargo`: this is one crate with no
# version-resolution question, and the bridge crate has no `Cargo.toml` (it is
# built by Bazel, which supplies `frustrate` as a label).
#
# `supported_platform_triples` REPLACES the crate_universe default set, so the
# defaults are re-listed alongside this app's cross-compile targets. A
# missing triple does not fail to fetch — the crate resolves to
# `//:incompatible` and surfaces as a `target_compatible_with` skip far from its
# cause — so this list must cover every triple //bridge:demo_rust is built for.
crate = use_extension("@rules_rust//crate_universe:extensions.bzl", "crate")
crate.spec(
    default_features = False,
    package = "log",
    version = "0.4",
)
crate.from_specs(
    name = "demo_crates",
    supported_platform_triples = [
        # crate_universe defaults:
        "aarch64-apple-darwin",
        "aarch64-unknown-linux-gnu",
        "wasm32-unknown-unknown",
        "wasm32-wasip1",
        "x86_64-pc-windows-msvc",
        "x86_64-unknown-linux-gnu",
        "x86_64-unknown-nixos-gnu",
        # this app's cross-compile targets:
        "aarch64-apple-ios",
        "aarch64-apple-ios-sim",
        "aarch64-linux-android",
        "x86_64-linux-android",
    ],
)
use_repo(crate, "demo_crates")

# binaryen, for the wasm-opt pass on the web module. frustrate ships the fetch
# and does not register it, so naming it here is the app opting in.
binaryen = use_extension("@frustrate//bazel/wasm_opt:extensions.bzl", "binaryen")
use_repo(binaryen, "binaryen")

register_toolchains("@flutter_toolchains//:all")

# ---------------------------------------------------------------- Android ---
# The rules_android / NDK / SDK wiring, copied from the rules_flutter
# hello_world example (its comments explain each pin).
#
# The SDK and NDK toolchains are registered by `build:android
# --extra_toolchains` in .bazelrc, NOT by register_toolchains() here. A
# registration in this file is evaluated during toolchain resolution for every
# build, which would fetch the NDK repo and fail every macOS, iOS, web and test
# build with "ANDROID_NDK_HOME must be set" for anyone without an NDK. Repos
# are fetched lazily, so naming them only in the android config keeps them
# opt-in.

go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk")
go_sdk.download(version = "1.27.1")

remote_android_extensions = use_extension(
    "@rules_android//bzlmod_extensions:android_extensions.bzl",
    "remote_android_tools_extensions",
)
use_repo(remote_android_extensions, "android_tools")

android_sdk_repository_extension = use_extension(
    "@rules_android//rules/android_sdk_repository:rule.bzl",
    "android_sdk_repository_extension",
)
android_sdk_repository_extension.configure(api_level = 35)
use_repo(android_sdk_repository_extension, "androidsdk")

android_ndk_repository_extension = use_extension(
    "@rules_android_ndk//:extension.bzl",
    "android_ndk_repository_extension",
)
use_repo(android_ndk_repository_extension, "androidndk")

# Fix protobuf version mismatch: rules_android pins protobuf-java 4.33.4 but the
# resolved protobuf module is newer. Re-declare the two affected repos with
# bumped protobuf jars (verbatim from hello_world).
maven = use_extension("@rules_jvm_external//:extensions.bzl", "maven")
maven.install(
    name = "android_ide_common_30_1_3",
    aar_import_bzl_label = "@rules_android//rules:rules.bzl",
    artifacts = [
        "com.android.tools.layoutlib:layoutlib-api:30.1.3",
        "com.android.tools.build:manifest-merger:30.1.3",
        "com.android.tools:common:30.1.3",
        "com.android.tools:repository:30.1.3",
        "com.android.tools.analytics-library:protos:30.1.3",
        "com.android.tools.analytics-library:shared:30.1.3",
        "com.android.tools.analytics-library:tracker:30.1.3",
        "com.android.tools:annotations:30.1.3",
        "com.android.tools:sdk-common:30.1.3",
        "com.android.tools.build:builder:7.1.3",
        "com.android.tools.build:builder-model:7.1.3",
        "com.google.protobuf:protobuf-java:4.34.0",
        "com.google.protobuf:protobuf-java-util:4.34.0",
    ],
    repositories = [
        # Google's mirror of Maven Central first: repo1 rate-limits (429).
        "https://maven-central.storage-download.googleapis.com/maven2",
        "https://maven.google.com",
        "https://repo1.maven.org/maven2",
    ],
    use_starlark_android_rules = True,
)
maven.install(
    name = "rules_android_maven",
    aar_import_bzl_label = "@rules_android//rules:rules.bzl",
    artifacts = [
        "androidx.privacysandbox.tools:tools:1.0.0-alpha06",
        "androidx.privacysandbox.tools:tools-apigenerator:1.0.0-alpha06",
        "androidx.privacysandbox.tools:tools-apipackager:1.0.0-alpha06",
        "androidx.test:core:1.6.0-alpha01",
        "androidx.test.ext:junit:1.2.0-alpha01",
        "com.android.tools.apkdeployer:apkdeployer:8.11.0-alpha10",
        "com.android.tools.build:bundletool:1.18.2",
        "com.android.tools:desugar_jdk_libs_minimal:2.1.5",
        "com.android.tools:desugar_jdk_libs_configuration_minimal:2.1.5",
        "com.android.tools:desugar_jdk_libs_nio:2.1.5",
        "com.android.tools:desugar_jdk_libs_configuration_nio:2.1.5",
        "com.android.tools:desugar_jdk_libs_configuration:2.1.5",
        "com.android.tools:r8:9.3.16",
        "org.bouncycastle:bcprov-jdk18on:1.77",
        "org.hamcrest:hamcrest-core:2.2",
        "org.robolectric:robolectric:4.14.1",
        "com.google.flogger:flogger:0.8",
        "com.google.flogger:flogger-system-backend:0.8",
        "com.google.guava:guava:32.1.2-jre",
        "com.google.guava:failureaccess:1.0.1",
        "info.picocli:picocli:4.7.4",
        "jakarta.inject:jakarta.inject-api:2.0.1",
        "junit:junit:4.13.2",
        "com.beust:jcommander:1.82",
        "com.google.protobuf:protobuf-java:4.34.0",
        "com.google.protobuf:protobuf-java-util:4.34.0",
        "com.google.code.findbugs:jsr305:3.0.2",
        "androidx.databinding:databinding-compiler:8.7.0",
        "org.ow2.asm:asm:9.6",
        "org.ow2.asm:asm-commons:9.6",
        "org.ow2.asm:asm-tree:9.6",
        "org.ow2.asm:asm-util:9.6",
