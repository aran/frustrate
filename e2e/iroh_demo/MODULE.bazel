# The demos live inside frustrate's tree and build against it.
local_path_override(
    module_name = "frustrate",
    path = "../..",
)

# The bridge crate's cargo dependencies. This is the first e2e module to need a
# crate hub at all: frustrate's `@crates` resolves frustrate's own manifests and
# hub repos are not re-exported to consumers, so the name here must NOT be
# "crates".
#
# `supported_platform_triples` REPLACES the crate_universe default set rather
# than extending it, so the defaults are re-listed alongside the app triples. A
# triple missing from this list does not fail to fetch: the crate resolves to
# `//:incompatible` and surfaces as a `target_compatible_with` skip at analysis
# time, far from its cause. The per-platform build_tests in //:BUILD.bazel are
# the guard that turns that into a red target.
crate = use_extension("@rules_rust//crate_universe:extensions.bzl", "crate")
crate.from_cargo(
    name = "iroh_crates",
    cargo_lockfile = "//bridge:Cargo.lock",
    manifests = ["//bridge:Cargo.toml"],
    supported_platform_triples = [
        # crate_universe defaults:
        "aarch64-apple-darwin",
        "aarch64-unknown-linux-gnu",
        "wasm32-unknown-unknown",
        "wasm32-wasip1",
        "x86_64-pc-windows-msvc",
        "x86_64-unknown-linux-gnu",
        "x86_64-unknown-nixos-gnu",
        # this app's cross-compile targets:
        "aarch64-apple-ios",
        "aarch64-apple-ios-sim",
        "aarch64-linux-android",
        "x86_64-linux-android",
    ],
)

# getrandom 0.4.3's js-sys dependency, which crate_universe cannot see.
#
# Upstream declares it as
#
#   [target.'cfg(all(target_family = "wasm",
#                    any(target_os = "unknown", target_os = "none"),
#                    target_feature = "atomics"))'.dependencies.js-sys]
#
# and crate_universe resolves cfg predicates **per triple**, during the module
# extension, before any RUSTFLAGS exist. `target_feature` is not a property of
# a triple — it is set by `-C target-feature=+atomics`, which the threaded wasm
# toolchain adds much later — so the predicate evaluates false for every triple
# in `supported_platform_triples` and the dependency is silently dropped. The
# same crate's 0.2.17 line in this hub wires js-sys correctly only because its
# manifest gates it on the triple alone.
#
# The consequence is invisible until something builds for
# `@frustrate//bazel:wasm32_threads`, where getrandom's `wasm_js` backend takes
# its `#[cfg(target_feature = "atomics")]` arm — the one that stages bytes
# through a `js_sys::Uint8Array` because "getRandomValues does not work with all
# types of WASM memory" — and rustc fails with
#
#   error[E0433]: failed to resolve: use of unresolved module or unlinked crate
#   `js_sys`  --> getrandom-0.4.3/src/backends/wasm_js.rs:35:15
#
# `annotation_select` rather than `annotation`: `annotation` adds the dep to
# every triple, and js-sys is `//:incompatible` off wasm32. `version = "0.4.3"`
# because 0.2.17 is in the same hub and already has it. `repositories` because
# one extension instance feeds all three hubs in this file.
#
# The single-threaded wasm build shares this triple and therefore gets the dep
# too, and that costs it nothing. Its arm of `fill_inner` hands the slice
# straight to `crypto.getRandomValues` and never names `js_sys`, so the rlib
# goes unused; and js-sys is already a direct dependency of the bridge
# (//bridge:Cargo.toml, for `Date.now()`), so the link set does not change
# either. The annotation adds a name to one rustc command line and nothing to
# the shipped module.
crate.annotation_select(
    crate = "getrandom",
    # The hub alias, not `@iroh_crates__js-sys-0.3.103//:js_sys`: it survives a
    # version bump in //bridge:Cargo.lock, which the pinned form would not.
    deps = ["@iroh_crates//:js-sys"],
    repositories = ["iroh_crates"],
    triples = ["wasm32-unknown-unknown"],
    version = "0.4.3",
)
use_repo(crate, "iroh_crates")

# The relay server's crate hub — deliberately a *second* hub rather than a line
# in //bridge:Cargo.toml. `iroh-relay`'s `server` feature pulls in clap, rcgen,
# tokio-rustls-acme, tracing-subscriber, a websocket server and a metrics HTTP
# service, and cargo feature unification is per-resolution: one shared manifest
# would link all of that into the phone. Two hubs cost two lockfiles; one hub
# would cost the app's binary size.
#
# Only the triples the relay is actually built for are listed. This list, like
# every `supported_platform_triples`, REPLACES the crate_universe defaults, and
# a missing triple resolves to `//:incompatible` at analysis time rather than
# failing loudly — //relay:BUILD.bazel's build_test is the guard.
crate.from_cargo(
    name = "relay_crates",
    cargo_lockfile = "//relay:Cargo.lock",
    manifests = ["//relay:Cargo.toml"],
    supported_platform_triples = [
        # the dev host, for `bazel run //relay:iroh_relay -- --dev`:
        "aarch64-apple-darwin",
        # the deployment target (//relay:linux_x86_64), and its arm64
        # alternative should the VM ever be a t2a:
        "x86_64-unknown-linux-gnu",
        "aarch64-unknown-linux-gnu",
    ],
)

# The relay server is upstream's own `[[bin]] iroh-relay`
# (`required-features = ["server"]`). crate_universe exposes only library
# targets by default, so the binary has to be opted into by name; without this
# the crate resolves fine and there is simply no runnable target anywhere.
crate.annotation(
    crate = "iroh-relay",
    gen_binaries = ["iroh-relay"],
    repositories = ["relay_crates"],
)
use_repo(crate, "relay_crates")

# The wasm-bindgen CLI's crate hub — a THIRD hub, for exactly the reason the
# relay has the second one. This is a host build tool whose graph (walrus,
# clap, an object-file rewriter; 206 packages) has nothing to do with the
# app's, and cargo feature unification is per-resolution.
#
# Why the CLI has to exist at all: `iroh` depends on `wasm-bindgen`
# structurally — a `[target.'cfg(wasm)'.dependencies]` entry in its own
# manifest, not a feature — so no flag escapes it, and rustc emits a module
# with 124 imports in a `__wbindgen_placeholder__` namespace (plus 2 in
# `__wbindgen_externref_xform__`) that `WebAssembly.instantiate` cannot satisfy.
# Running the CLI collapses all of them into ONE resolvable namespace of 131
# functions, and leaves frustrate's own `extern "C"` exports and `frustrate`
# import namespace untouched. The wasm build has no other way to load.
#
# Why not `rules_rust_wasm_bindgen`, which ships this rule ready-made: two
# reasons, both structural. Its stock toolchain pins wasm-bindgen 0.2.105 and
# this graph's floor is 0.2.106 (`netwatch` → `js-sys 0.3.83` →
# `wasm-bindgen "=0.2.106"`), and its `rust_wasm_bindgen` rule applies a
# transition of its own to `@rules_rust//rust/platform:wasm32`, which would
# bypass `frustrate_wasm_module`'s transition to `@frustrate//bazel:wasm32` and
# with it the whole web build configuration frustrate owns. So frustrate's own
# rule runs the CLI instead, and this hub supplies the binary.
crate.from_cargo(
    name = "wasm_bindgen_crates",
    cargo_lockfile = "//bazel/wasm_bindgen:Cargo.lock",
    manifests = ["//bazel/wasm_bindgen:Cargo.toml"],
    # Host-only: this is a build tool, never cross-compiled.
    supported_platform_triples = [
        "aarch64-apple-darwin",
        "x86_64-unknown-linux-gnu",
    ],
)

# Upstream's own `[[bin]] wasm-bindgen`. crate_universe exposes only library
# targets by default, so the binary has to be opted into by name — and the
# annotation that does it can only live here, in MODULE.bazel. Without it the
# crate resolves fine and there is simply no runnable target anywhere.
crate.annotation(
    crate = "wasm-bindgen-cli",
    gen_binaries = ["wasm-bindgen"],
    repositories = ["wasm_bindgen_crates"],
)
use_repo(crate, "wasm_bindgen_crates")

# binaryen, for the wasm-opt pass on the web module. frustrate ships the fetch
# but does not register it — a binaryen release is a large download, so the app
# decides whether to pull it in. This app does: the web module is the one
# artifact here that crosses a network to reach a user, which is where module
# size is worth a build dependency.
binaryen = use_extension("@frustrate//bazel/wasm_opt:extensions.bzl", "binaryen")
use_repo(binaryen, "binaryen")



# ------------------------------------------------------------- toolchains ---
# The C/C++ toolchain, for wasm32 and Linux. One module, `@llvm`, covering both
# — and deliberately NOT covering macOS or iOS, which stay on Xcode.
#
# Why a cc_toolchain is needed at all, for each:
#
#  * wasm32 — `ring` reaches every triple through rustls, and without a
#    `cc_toolchain` for `cpu:wasm32 + os:none` its build script runs Apple's
#    /usr/bin/clang, a fork built with no WebAssembly LLVM backend. The failure
#    names neither frustrate nor the missing toolchain: `unable to create
#    target: 'No available targets are compatible with triple
#    "wasm32-unknown-unknown"'`, from inside a third-party build script.
#
#  * Linux — nothing in frustrate, rules_flutter or rules_dart registers one, so
#    from a macOS host no Linux target could be analysed at all. The first thing
#    to need it is rules_rust's own allocator shim, which every
#    `rust_binary`/`rust_shared_library` links, and the failure names neither
#    Linux nor the target you asked for. //:app_linux and //relay both depend on
#    this.
#
# `@llvm` (hermeticbuild/hermetic-llvm) rather than `@toolchains_llvm`
# (bazel-contrib), which this module used until 2026-09-08. Neither is
# deprecated; the swap bought two specific deletions, and nothing else:
#
#  1. //bazel:wasm.bzl, entirely. It held an empty-sysroot filegroup and a pin
#     of `libclang_rt.builtins-wasm32.a` to wasi-sdk-24. That pin was the
#     liability — wasi-sdk moved the flat archive into per-target directories
#     with no `wasm32-unknown-unknown/` among them, so it could never be bumped
#     in place, only replaced. `@llvm` ships wasm32 as a first-class target.
#
#  2. The 13,423-file Chromium bullseye sysroot, and with it the `-L` into that
#     sysroot that `extra_link_flags` used to carry. `@llvm` is zero-sysroot: it
#     cross-compiles glibc and libc++ from source, so the Flutter GTK runner
#     link no longer puts a foreign sysroot's `libm.so` ld script on the command
#     line and the workaround for it is gone with the cause. Every Linux compile
#     action taking that whole sysroot as an input is gone too.
#
# Verified on Debian 12 (glibc 2.36), cross-compiled from macOS arm64: the
# Flutter app starts under Xvfb and reaches its Dart VM service, `//relay`
# binds and reports ready, and the app binary needs no symbol newer than
# GLIBC_2.16. A green build is not evidence for any of that.
#
# NO `toolchain.exec` tag: exec defaults to every supported host, so this stays
# correct when the host is Linux rather than macOS. Pinning it would leave a
# Linux developer with no toolchain at all, the tags being a cross-product.
#
# NO macOS/iOS `toolchain.target`: the Apple apps build with Xcode's toolchain.
#
# NEVER register emsdk alongside this. emsdk's cc_toolchain declares
# `target_compatible_with = ["@platforms//cpu:wasm32"]` with no OS constraint,
# so it also matches `cpu:wasm32 + os:none` and collides here. It is the wrong
# shape anyway (`wasm32-unknown-emscripten` is a different Rust triple with a
# different ABI). BCR's `rules_wasm` is likewise not a candidate: every
# `tool_path` in it is the literal string "ignored" and it compiles no C.
cc = use_extension("@llvm//extensions:toolchain.bzl", "toolchain")
cc.target(
    arch = "wasm32",
    os = "none",
)
cc.target(
    arch = "x86_64",
    os = "linux",
)
use_repo(cc, "llvm_toolchains")

register_toolchains("@llvm_toolchains//:all")

flutter = use_extension("@rules_flutter//flutter:extensions.bzl", "flutter")
flutter.toolchain(flutter_version = "3.47.5")
flutter.pub(
    name = "deps",
    lock = "//:pubspec.lock",
)
use_repo(flutter, "deps", "dev_tool_deps", "flutter_android_engine_arm64", "flutter_ios_engine", "flutter_macos_engine", "flutter_toolchains", "flutter_web_sdk")

register_toolchains("@flutter_toolchains//:all")

# ---------------------------------------------------------------- Android ---
# The rules_android / NDK / SDK wiring, copied from the rules_flutter
# hello_world example (its comments explain each pin).
#
# The SDK and NDK toolchains are registered by `build:android
# --extra_toolchains` in .bazelrc, NOT by register_toolchains() here. A
# registration in this file is evaluated during toolchain resolution for every
# build, which would fetch the NDK repo and fail every macOS, iOS, web and test
# build with "ANDROID_NDK_HOME must be set" for anyone without an NDK. Repos
# are fetched lazily, so naming them only in the android config keeps them
# opt-in.

go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk")
go_sdk.download(version = "1.27.1")

remote_android_extensions = use_extension(
    "@rules_android//bzlmod_extensions:android_extensions.bzl",
    "remote_android_tools_extensions",
)
use_repo(remote_android_extensions, "android_tools")

android_sdk_repository_extension = use_extension(
    "@rules_android//rules/android_sdk_repository:rule.bzl",
    "android_sdk_repository_extension",
)
android_sdk_repository_extension.configure(api_level = 35)
use_repo(android_sdk_repository_extension, "androidsdk")

android_ndk_repository_extension = use_extension(
    "@rules_android_ndk//:extension.bzl",
    "android_ndk_repository_extension",
)
use_repo(android_ndk_repository_extension, "androidndk")

