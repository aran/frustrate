"""The iroh demo: a peer-to-peer Flutter app whose networking layer is the Rust
iroh 1.0 crate family, bridged through frustrate and built with rules_flutter.

A separate module from e2e/flutter_demo on purpose: the demo gallery is
frustrate's own portability proof and must not acquire a 378-package
dependency.

Android is opt-in: `--config=android` (see .bazelrc) is what registers the SDK
and NDK toolchains, so every other build needs no Android setup.

Web (wasm32) ships as of M5, and is second-class on purpose: browsers cannot
send UDP, so the browser peer is relay-only over WebSocket with no hole
punching, ever. Getting there needed two things this file registers — a wasm
cc_toolchain, because `ring` reaches every triple through rustls, and a
version-matched wasm-bindgen CLI, because iroh depends on wasm-bindgen
structurally.
"""

module(name = "frustrate_iroh_demo")

bazel_dep(name = "frustrate", version = "0.1.0")
bazel_dep(name = "rules_flutter", version = "0.0.4")
bazel_dep(name = "rules_dart", version = "0.7.1")
# 0.70.0 is a floor, not a current version: earlier releases auto-register a
# fake wasm32 cc_toolchain that resolves ahead of the real one below, so a
# downgrade breaks ring's build script far from the cause.
# <https://github.com/bazelbuild/rules_rust/pull/3892> (checked 2026-09-02).
bazel_dep(name = "rules_rust", version = "0.74.0")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "bazel_skylib", version = "1.9.2")
bazel_dep(name = "apple_support", version = "2.9.0")
bazel_dep(name = "rules_apple", version = "5.1.0")
bazel_dep(name = "rules_cc", version = "0.2.25")
bazel_dep(name = "rules_swift", version = "4.1.1")
bazel_dep(name = "llvm", version = "0.8.23")

# Android bundling (rules_flutter's flutter_android_app + the NDK cc toolchain
# that cross-compiles the Rust bridge to android_arm64).
bazel_dep(name = "rules_android", version = "0.7.3")
bazel_dep(name = "rules_android_ndk", version = "0.1.5")
bazel_dep(name = "rules_kotlin", version = "2.4.20")
bazel_dep(name = "rules_java", version = "9.9.0")
bazel_dep(name = "rules_go", version = "0.63.0")
bazel_dep(name = "rules_jvm_external", version = "7.1")

# Pinned to a commit, not a release: 0.1.5 hardcodes
# `-Wl,-z,max-page-size=4096` in its toolchain, so every Android .so links
# 4KB-aligned. A device running 16KB pages then refuses to load them: "ELF
# alignment check failed". Nothing surfaces at build time;
# the APK builds, installs, and dies on launch, which is why a green build
# is not evidence here.
#
# `main` replaced that with 16384 for both max- and common-page-size across
# all link actions. Fixing it in the toolchain rather than per-target also
# covers native libraries this module does not own.
archive_override(
    module_name = "rules_android_ndk",
    sha256 = "420b58372108f974979ff7417959d1409b90bc6d70677e17da005844f4eb8d54",
    strip_prefix = "rules_android_ndk-8ba0720dcf044fc1cdd82ca8160df0dd394f8711",
    urls = ["https://github.com/bazelbuild/rules_android_ndk/archive/8ba0720dcf044fc1cdd82ca8160df0dd394f8711.tar.gz"],
)

# This app bundles the Rust bridge for every platform it targets, so it
# declares the cross-compile triples here: the app module is the root of its
# own build, and a dependency's (frustrate's) toolchain config does not
# propagate. `extra_target_triples` REPLACES the rules_rust default, so any
# triple this app builds for must appear here.
#
# `x86_64-unknown-linux-gnu` serves both //:app_linux and //relay. It is only
# the *rust* half of cross-compiling there; the C half is the `cc_toolchain`
# registered below, without which nothing Linux gets past analysis.
#
# `wasm32-unknown-unknown` is the same story for web. frustrate's
# `frustrate_wasm_module` transitions to `@frustrate//bazel:wasm32`, but the
# transition only sets a *platform* — the rust toolchain for that triple is the
# consuming module's to register, and this list REPLACES the rules_rust default
# (which does include wasm32). Omitting it does not degrade to a native build:
# analysis dies with "No matching toolchains found for types:
# @@rules_rust+//rust:toolchain_type", naming neither wasm nor this list.
rust = use_extension("@rules_rust//rust:extensions.bzl", "rust")
rust.toolchain(
    edition = "2021",
    versions = ["1.98.1"],
    # rules_rust has no checksums for 1.98.1; without these the toolchain
