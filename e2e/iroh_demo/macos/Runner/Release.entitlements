<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  KEEP IN SYNC WITH DebugProfile.entitlements, minus allow-jit (the release
  engine is AOT and does not JIT).

  The two network keys are the whole point of this file: `flutter create`
  writes them into the debug entitlements only, which makes a networked app
  work perfectly in development and go silently offline in `-c opt` with no
  build error and no runtime exception — the sandbox simply denies the socket,
  and a peer-to-peer app looks like it has no peers.
-->
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.network.client</key>
	<true/>
	<key>com.apple.security.network.server</key>
	<true/>
</dict>
</plist>
