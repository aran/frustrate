load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_test")

# The check configuration's linker: rust-lld with the export list cut back to
# the check roots, so "the only exports are the roots" survives a crate graph
# whose dependency rlibs carry `#[wasm_bindgen]` exports. The custom-std
# toolchains put it in their sysroot, built for each execution host, and each
# names it with `-Clinker=` under //bazel:no_block_check.
rust_binary(
    name = "link_filter",
    srcs = ["link_filter.rs"],
    edition = "2021",
    rustc_flags = ["-Dwarnings"],
    visibility = ["//visibility:public"],
)

rust_test(
    name = "link_filter_test",
    crate = ":link_filter",
    edition = "2021",
)

# The `#[bridge(no_block)]` gate: it decodes a check artifact's code section and
# fails if a claimed body can reach `memory.atomic.wait` or a `--slow` path.
# With `--ir` it reads a native build's whole-program LLVM IR instead (ir.rs). See main.rs for the
# decision procedure, the panic-path exemption and what green does not claim.
#
# Its crates, wasmparser and rustc-demangle, come from the @frustrate_crates hub
# that every consumer already resolves for the runtime; the scanner is built
# once, in the exec configuration.
rust_binary(
    name = "no_block_check",
    srcs = [
        "budget.rs",
        "io.rs",
        "ir.rs",
        "libc.rs",
        "main.rs",
        "modules.rs",
        "provenance.rs",
        "silences.rs",
        "symbol.rs",
    ],
    edition = "2021",
    rustc_flags = ["-Dwarnings"],
    visibility = ["//visibility:public"],
    deps = [
        "@frustrate_crates//:rustc-demangle",
        "@frustrate_crates//:wasmparser",
    ],
)

rust_test(
    name = "no_block_check_test",
    crate = ":no_block_check",
    edition = "2021",
)

# The IR reader's direct calls against `opt -passes=print-callgraph`, from the
# llvm-tools of the same Rust release, over real check-build IR: every native
# platform's, at opt-level 0 and 2, inline asm included (callgraph_check.rs).
# The module and its cfg exist in this target alone. SKIPPED on a host
# :opt has no `opt` for.
_MODULES = [
    "//tests/bazel_rules/native_red/asm:artifacts",
    "//tests/bazel_rules/native_red/dirty:artifacts",
    "//tests/bazel_rules/native_red/optimized:artifacts",
]

rust_test(
    name = "callgraph_test",
    # Only the cross-check: the unit tests run in :no_block_check_test.
    args = ["callgraph_check::"],
    compile_data = ["callgraph_check.rs"],
    crate = ":no_block_check",
    data = [":opt"] + _MODULES,
    edition = "2021",
    env = {
        "MODULES": " ".join(["$(rootpaths %s)" % m for m in _MODULES]),
        "OPT": "$(rootpath :opt)",
    },
    rustc_flags = ["--cfg=callgraph_check"],
)

# `opt` for the host, from the Rust toolchain's llvm-tools (llvm_opt.bzl).
alias(
    name = "opt",
    actual = select({
        ":linux_aarch64": "@llvm_opt_linux_aarch64//:opt",
        ":linux_x86_64": "@llvm_opt_linux_x86_64//:opt",
        ":macos_aarch64": "@llvm_opt_macos_aarch64//:opt",
        "//conditions:default": ":no_opt",
    }),
)

filegroup(
    name = "no_opt",
    target_compatible_with = ["@platforms//:incompatible"],
)

[config_setting(
    name = os + "_" + cpu,
    constraint_values = [
        "@platforms//os:" + os,
        "@platforms//cpu:" + cpu,
    ],
) for os, cpu in [
    ("linux", "aarch64"),
    ("linux", "x86_64"),
    ("macos", "aarch64"),
]]
