load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_test")

# The check configuration's linker: rust-lld with the export list cut back to
# the check roots, so "the only exports are the roots" survives a crate graph
# whose dependency rlibs carry `#[wasm_bindgen]` exports. The custom-std
# toolchains put it in their sysroot, built for each execution host, and
# `frustrate_block_check`'s transition names it with `-Clinker=`.
rust_binary(
    name = "link_filter",
    srcs = ["link_filter.rs"],
    edition = "2021",
    rustc_flags = ["-Dwarnings"],
    visibility = ["//visibility:public"],
)

rust_test(
    name = "link_filter_test",
    crate = ":link_filter",
    edition = "2021",
)

# The `#[bridge(no_block)]` gate: it decodes a check artifact's code section and
# fails if a claimed body can reach `memory.atomic.wait` or a `--slow` path. See main.rs for the
# decision procedure, the panic-path exemption and what green does not claim.
#
# Zero dependencies, matching //bazel/wasm_std_check and
# //codegen:frustrate_codegen_bin as exec tools: a crate would drag the
# @frustrate_crates hub into every consumer's exec configuration. It is also a cargo workspace
# member, so `tools/check_block.dart` and the Bazel validation action run the
# identical binary.
rust_binary(
    name = "wasm_block_check",
    srcs = ["main.rs"],
    edition = "2021",
    rustc_flags = ["-Dwarnings"],
    visibility = ["//visibility:public"],
)

rust_test(
    name = "wasm_block_check_test",
    crate = ":wasm_block_check",
    edition = "2021",
)
