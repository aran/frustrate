load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_test")

# The check configuration's linker: rust-lld with the export list cut back to
# the check roots, so "the only exports are the roots" survives a crate graph
# whose dependency rlibs carry `#[wasm_bindgen]` exports. The custom-std
# toolchains put it in their sysroot, built for each execution host, and each
# names it with `-Clinker=` under //bazel:block_check.
rust_binary(
    name = "link_filter",
    srcs = ["link_filter.rs"],
    edition = "2021",
    rustc_flags = ["-Dwarnings"],
    visibility = ["//visibility:public"],
)

rust_test(
    name = "link_filter_test",
    crate = ":link_filter",
    edition = "2021",
)

# The `#[bridge(no_block)]` gate: it decodes a check artifact's code section and
# fails if a claimed body can reach `memory.atomic.wait` or a `--slow` path.
# With `--ir` it reads a native build's whole-program LLVM IR instead (ir.rs). See main.rs for the
# decision procedure, the panic-path exemption and what green does not claim.
#
# Its crates, wasmparser and rustc-demangle, come from the @frustrate_crates hub
# that every consumer already resolves for the runtime; the scanner is built
# once, in the exec configuration.
rust_binary(
    name = "wasm_block_check",
    srcs = ["budget.rs", "io.rs", "ir.rs", "libc.rs", "main.rs", "provenance.rs", "silences.rs", "symbol.rs"],
    edition = "2021",
    rustc_flags = ["-Dwarnings"],
    visibility = ["//visibility:public"],
    deps = [
        "@frustrate_crates//:rustc-demangle",
        "@frustrate_crates//:wasmparser",
    ],
)

rust_test(
    name = "wasm_block_check_test",
    crate = ":wasm_block_check",
    edition = "2021",
)
