"""Metadata applying to every package of the module."""

repo(
    default_package_metadata = [
        "//:package_metadata",
    ],
)

# Not packages of this module, in a consumer's copy of a checkout either (where
# `.bazelignore` would not apply): Bazel's convenience symlinks, and the
# commit hooks' tools (`.pre-commit-config.yaml`), which link into an output
# base.
ignore_directories([
    "bazel-*",
    ".bazel_env",
])
