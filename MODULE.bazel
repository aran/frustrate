"""frustrate: Flutter/Dart + Rust interop, Bazel-native."""

# The version is left unset on purpose: the release workflow's publish step
# patches in the released tag's version when it submits to the Bazel Central
# Registry, and an unset version keeps the module usable through non-registry
# overrides.
module(
    name = "frustrate",
    bazel_compatibility = [">=9.3.0"],
)

bazel_dep(name = "rules_rust", version = "0.75.0")
bazel_dep(name = "rules_dart", version = "0.8.1")
bazel_dep(name = "platforms", version = "1.1.0")

# The license and package declaration every target of the module carries
# (//:package_metadata, set in REPO.bazel).
bazel_dep(name = "package_metadata", version = "0.0.13")

# For the constraint that marks an iOS device platform (//bazel:ios_aarch64).
bazel_dep(name = "apple_support", version = "2.12.0")

# build_test, for the Bazel rule tests in //tests/bazel_rules. Already in the
# resolved graph (a transitive dep of rules_rust); declared direct so
# @bazel_skylib is visible from the root module.
bazel_dep(name = "bazel_skylib", version = "1.9.2")

# cc_library, for //runtime/rust:hot_patch_link — the link flags a patchable
# library needs, which a select() has to choose per object format. Already in
# the resolved graph, declared direct for the same reason as bazel_skylib.
bazel_dep(name = "rules_cc", version = "0.2.28")

# The dev tooling shared with rules_dart: the commit check, the changelog, the
# lint hooks and the release steps. It lives in rules_dart at `overhead/`.
bazel_dep(name = "overhead", version = "0.0.0", dev_dependency = True)
git_override(
    module_name = "overhead",
    commit = "4dc9403ab62273d54c5d97b62c1faad0381059a2",
    remote = "https://github.com/aran/rules_dart.git",
    strip_prefix = "overhead",
)

rust = use_extension("@rules_rust//rust:extensions.bzl", "rust")
rust.toolchain(
    edition = "2021",
    # rules_rust's defaults, and the std of every platform the native
    # no_block analyses build for (//bazel:BUILD.bazel). Replaces the
    # default list.
    extra_target_triples = [
        "aarch64-apple-darwin",
        "aarch64-unknown-linux-gnu",
        "x86_64-apple-darwin",
        "x86_64-unknown-linux-gnu",
        "wasm32-unknown-unknown",
        "wasm32-wasip1",
        "wasm32-wasip2",
        "aarch64-apple-ios",
        "aarch64-linux-android",
        "x86_64-linux-android",
    ],
    versions = ["1.99.1"],
)
use_repo(rust, "rust_toolchains")

# `opt` from the llvm-tools archive rules_rust unpacks into each host
# toolchain's tools repo, for //bazel/no_block_check:callgraph_test, which
# checks the native IR reader against LLVM's own call graph. Dev-only.
rust_dev = use_extension(
    "@rules_rust//rust:extensions.bzl",
    "rust",
    dev_dependency = True,
)
use_repo(
    rust_dev,
    "rust_linux_aarch64__aarch64-unknown-linux-gnu__stable_tools",
    "rust_linux_x86_64__x86_64-unknown-linux-gnu__stable_tools",
    "rust_macos_aarch64__aarch64-apple-darwin__stable_tools",
)

llvm_opt = use_extension(
    "//bazel/no_block_check:llvm_opt.bzl",
    "llvm_opt",
    dev_dependency = True,
)
use_repo(
    llvm_opt,
    "llvm_opt_linux_aarch64",
    "llvm_opt_linux_x86_64",
    "llvm_opt_macos_aarch64",
)

# Custom wasm stds: pinned nightly + a locally built, patched std, one repo per
# flavour (bazel/custom_std.bzl). Each is a loud fail()-ing stub until its
# flavour has been staged by the builder.
custom_std = use_extension("//bazel:custom_std.bzl", "custom_std")
use_repo(
    custom_std,
    "frustrate_custom_std_browser",
    "frustrate_custom_std_threads",
    "frustrate_nightly_host",
)

# Order does NOT matter here, and that is deliberate — do not start relying on
# it. All three toolchains for wasm32-unknown-unknown are mutually exclusive on
# constraints alone:
#
#   stock (@rust_toolchains)  target_settings = channel:stable
#   threads                   wasm_threads_enabled  + wasm_std_custom
#   browser                   wasm_threads_disabled + wasm_std_custom
#
# so //bazel:wasm32 (stable, stock std), :wasm32_threads and :wasm32_custom each
# resolve exactly one. Every stock toolchain carries a stable channel gate, so
# the order is not load-bearing. Keep it that way: the three differ in
# extra_rustc_flags, so a wrong pick is a link error far from its cause rather
# than a resolution error.
#
# The host toolchain is gated on the channel flag (nightly only) and builds the
# proc-macros and build scripts that a custom-std build's nightly rustc consumes
# — a stable proc-macro dylib does not load into nightly rustc.
register_toolchains(
    "@frustrate_custom_std_threads//:all",
    "@frustrate_custom_std_browser//:all",
    "@frustrate_nightly_host//:all",
)

register_toolchains("@rust_toolchains//:all")

# The C/C++ toolchain for frustrate's own Linux builds: hermetic clang and lld,
# zero-sysroot, so a Linux build takes nothing from the host. Registered by
# name for Linux targets only, from a Linux or a macOS host; Apple targets stay
# on Xcode. A dev dependency, because which C toolchain a build uses is the
# root module's choice and never a ruleset's. Its unwinder reaches Rust links
# through //runtime/rust:unwinder, set in .bazelrc.
bazel_dep(name = "llvm", version = "0.8.26", dev_dependency = True)

register_toolchains(
    "@llvm//toolchain:linux_x86_64_to_linux_x86_64",
    "@llvm//toolchain:linux_x86_64_to_linux_aarch64",
    "@llvm//toolchain:linux_aarch64_to_linux_aarch64",
    "@llvm//toolchain:linux_aarch64_to_linux_x86_64",
    "@llvm//toolchain:macos_aarch64_to_linux_x86_64",
    "@llvm//toolchain:macos_aarch64_to_linux_aarch64",
    "@llvm//toolchain:macos_x86_64_to_linux_x86_64",
    "@llvm//toolchain:macos_x86_64_to_linux_aarch64",
    dev_dependency = True,
)

crate = use_extension("@rules_rust//crate_universe:extensions.bzl", "crate")
crate.from_cargo(
    name = "frustrate_crates",
    cargo_lockfile = "//:Cargo.lock",
    # Required for any module that another module depends on: a transitive
    # `crate_universe` call cannot repin across a module boundary, so the
    # resolution has to be checked in. Without it the e2e demos — which
    # `bazel_dep` on frustrate — fail during module resolution, before any
    # target is analysed. Repin with
    # `CARGO_BAZEL_REPIN=1 bazel build //...` after changing Cargo.lock.
    lockfile = "//:Cargo.Bazel.lock",
    # Only the workspace root manifest — its `members` list implies every crate,
    # and crate_universe splices them from there (each member manifest still
    # shows up in the extension's recorded inputs, so edits re-splice). Do not
    # re-list members; rules_rust prints an INFO asking for their removal.
    manifests = ["//:Cargo.toml"],
    # The runtime has an unconditional external-crate dep (async-task, for the
    # executor), so every target a downstream app cross-compiles to must be
    # a supported triple here or the crate resolves to `//:incompatible` (the
    # iOS/Android/Linux demo builds fail otherwise). This replaces the
    # crate_universe default set, so the defaults are re-listed alongside the
    # mobile triples the demo declares in `extra_target_triples`.
    supported_platform_triples = [
        # crate_universe defaults:
        "aarch64-apple-darwin",
        "aarch64-unknown-linux-gnu",
        "wasm32-unknown-unknown",
        "wasm32-wasip1",
        "x86_64-pc-windows-msvc",
        "x86_64-unknown-linux-gnu",
        "x86_64-unknown-nixos-gnu",
        # mobile cross-compile targets (apps declare these in their own
        # extra_target_triples; the crate universe must resolve deps for them):
        "aarch64-apple-ios",
        "aarch64-apple-ios-sim",
        "aarch64-linux-android",
        "x86_64-linux-android",
    ],
)
use_repo(crate, "frustrate_crates")

# The wasm-bindgen fixture (//tests/bindgen): its third-party crates and the
# wasm-bindgen CLI, each a hub of its own and dev-only, so neither reaches a
# module that depends on frustrate nor grows `frustrate_crates`' resolution.
crate_dev = use_extension(
    "@rules_rust//crate_universe:extensions.bzl",
    "crate",
    dev_dependency = True,
)
crate_dev.from_cargo(
    name = "bindgen_test_crates",
    cargo_lockfile = "//tests/bindgen:Cargo.lock",
    manifests = ["//tests/bindgen:Cargo.toml"],
    supported_platform_triples = [
        "aarch64-apple-darwin",
        "wasm32-unknown-unknown",
        "x86_64-unknown-linux-gnu",
    ],
)

# The CLI's version must equal the `wasm-bindgen` pin in the fixture's lock.
# Upstream's own `[[bin]] wasm-bindgen`, opted into by name.
crate_dev.from_cargo(
    name = "wasm_bindgen_crates",
    cargo_lockfile = "//tests/bindgen/cli:Cargo.lock",
    manifests = ["//tests/bindgen/cli:Cargo.toml"],
    supported_platform_triples = [
        "aarch64-apple-darwin",
        "x86_64-unknown-linux-gnu",
    ],
)
crate_dev.annotation(
    crate = "wasm-bindgen-cli",
    gen_binaries = ["wasm-bindgen"],
    repositories = ["wasm_bindgen_crates"],
)

# The native check's memchr fixture (//tests/bazel_rules/native_red/memchr).
crate_dev.from_cargo(
    name = "native_red_crates",
    cargo_lockfile = "//tests/bazel_rules/native_red/memchr:Cargo.lock",
    manifests = ["//tests/bazel_rules/native_red/memchr:Cargo.toml"],
    supported_platform_triples = [
        "aarch64-apple-darwin",
        "aarch64-linux-android",
        "aarch64-unknown-linux-gnu",
        "x86_64-linux-android",
        "x86_64-unknown-linux-gnu",
    ],
)

# tokio, for the async-runtime hook's tests and `//ext/tokio` (//tests/tokio_hook).
# A hub of its own: tokio in `frustrate_crates` would reach every triple
# frustrate builds for.
crate_dev.from_cargo(
    name = "tokio_test_crates",
    cargo_lockfile = "//tests/tokio_hook:Cargo.lock",
    manifests = ["//tests/tokio_hook:Cargo.toml"],
    supported_platform_triples = [
        "aarch64-apple-darwin",
        "x86_64-unknown-linux-gnu",
    ],
)
use_repo(
    crate_dev,
    "bindgen_test_crates",
    "native_red_crates",
    "tokio_test_crates",
    "wasm_bindgen_crates",
)

dart = use_extension("@rules_dart//dart:extensions.bzl", "dart")
dart.toolchain(dart_version = "3.13.7")
use_repo(dart, "dart_toolchains")

register_toolchains("@dart_toolchains//:all")

# binaryen, for the wasm-opt pass on the web modules. Declared here so
# //tests/bazel_rules can exercise the pass; the repository is LAZY, so a
# consumer that never builds a target naming `@binaryen//:wasm-opt` never
# downloads it. //bazel/wasm_opt/extensions.bzl has the reasoning.
binaryen = use_extension("//bazel/wasm_opt:extensions.bzl", "binaryen")
use_repo(binaryen, "binaryen")

pub = use_extension("@rules_dart//dart/pub:extensions.bzl", "pub")
pub.from_lock(
    name = "pub_deps",
    lock = "//runtime/dart:pubspec.lock",
    # The runfiles library of the rules_dart this module builds with, which an
    # override of rules_dart replaces too.
    resolve = {"runfiles": "@rules_dart//dart/runfiles"},
)
use_repo(pub, "pub_deps")
