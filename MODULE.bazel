use_repo(rust, "rust_toolchains")

# Custom wasm stds: pinned nightly + a locally built, patched std, one repo per
# flavour (bazel/custom_std.bzl). Each is a loud fail()-ing stub until its
# flavour has been staged by the builder.
custom_std = use_extension("//bazel:custom_std.bzl", "custom_std")
use_repo(
    custom_std,
    "frustrate_custom_std_browser",
    "frustrate_custom_std_threads",
    "frustrate_nightly_host",
    "frustrate_nightly_tools",
)

# Order does NOT matter here, and that is deliberate — do not start relying on
# it. All three toolchains for wasm32-unknown-unknown are mutually exclusive on
# constraints alone:
#
#   stock (@rust_toolchains)  target_settings = channel:stable
#   threads                   wasm_threads_enabled  + wasm_std_custom
#   browser                   wasm_threads_disabled + wasm_std_custom
#
# so //bazel:wasm32 (stable, stock std), :wasm32_threads and :wasm32_custom each
# resolve exactly one. An earlier version of this comment claimed the order was
# load-bearing; it is not, because every stock toolchain carries a stable
# channel gate. Keeping it order-independent is worth the care: the three differ
# in extra_rustc_flags, so a wrong pick is a link error far from its cause
# rather than a resolution error.
#
# The host toolchain is gated on the channel flag (nightly only) and builds the
# proc-macros and build scripts that a custom-std build's nightly rustc consumes
# — a stable proc-macro dylib does not load into nightly rustc.
register_toolchains(
    "@frustrate_custom_std_threads//:toolchain",
    "@frustrate_custom_std_browser//:toolchain",
    "@frustrate_nightly_host//:host_toolchain",
)

register_toolchains("@rust_toolchains//:all")

# The C/C++ toolchain for frustrate's own Linux builds: hermetic clang and lld,
# zero-sysroot, so a Linux build takes nothing from the host. Registered by
# name for Linux targets only, from a Linux or a macOS host; Apple targets stay
# on Xcode. A dev dependency, because which C toolchain a build uses is the
# root module's choice and never a ruleset's. Its unwinder reaches Rust links
# through //runtime/rust:unwinder, set in .bazelrc.
bazel_dep(name = "llvm", version = "0.8.24", dev_dependency = True)

register_toolchains(
    "@llvm//toolchain:linux_x86_64_to_linux_x86_64",
    "@llvm//toolchain:linux_x86_64_to_linux_aarch64",
    "@llvm//toolchain:linux_aarch64_to_linux_aarch64",
    "@llvm//toolchain:linux_aarch64_to_linux_x86_64",
    "@llvm//toolchain:macos_aarch64_to_linux_x86_64",
    "@llvm//toolchain:macos_aarch64_to_linux_aarch64",
    "@llvm//toolchain:macos_x86_64_to_linux_x86_64",
    "@llvm//toolchain:macos_x86_64_to_linux_aarch64",
    dev_dependency = True,
)

crate = use_extension("@rules_rust//crate_universe:extensions.bzl", "crate")
crate.from_cargo(
    name = "crates",
    cargo_lockfile = "//:Cargo.lock",
    # Required since rules_rust 0.74.0 for any module that another module
    # depends on: a transitive `crate_universe` call cannot repin across a
    # module boundary, so the resolution has to be checked in. Without it the
    # e2e demos — which `bazel_dep` on frustrate — fail during module
    # resolution, before any target is analysed. Repin with
    # `CARGO_BAZEL_REPIN=1 bazel build //...` after changing Cargo.lock.
    lockfile = "//:Cargo.Bazel.lock",
    # Only the workspace root manifest — its `members` list implies every crate,
    # and crate_universe splices them from there (each member manifest still
    # shows up in the extension's recorded inputs, so edits re-splice). Do not
    # re-list members; rules_rust prints an INFO asking for their removal.
    manifests = ["//:Cargo.toml"],
    # The runtime now has an unconditional external-crate dep (async-task, for
    # the executor), so every target a downstream app cross-compiles to must be
    # a supported triple here or the crate resolves to `//:incompatible` (the
    # iOS/Android/Linux demo builds fail otherwise). This replaces the
    # crate_universe default set, so the defaults are re-listed alongside the
    # mobile triples the demo declares in `extra_target_triples`.
    supported_platform_triples = [
        # crate_universe defaults:
        "aarch64-apple-darwin",
        "aarch64-unknown-linux-gnu",
        "wasm32-unknown-unknown",
        "wasm32-wasip1",
        "x86_64-pc-windows-msvc",
        "x86_64-unknown-linux-gnu",
        "x86_64-unknown-nixos-gnu",
        # mobile cross-compile targets (apps declare these in their own
        # extra_target_triples; the crate universe must resolve deps for them):
        "aarch64-apple-ios",
        "aarch64-apple-ios-sim",
        "aarch64-linux-android",
        "x86_64-linux-android",
    ],
)
use_repo(crate, "crates")

dart = use_extension("@rules_dart//dart:extensions.bzl", "dart")
dart.toolchain(dart_version = "3.13.2")
use_repo(dart, "dart_toolchains")

register_toolchains("@dart_toolchains//:all")

# binaryen, for the wasm-opt pass on the web modules. Declared here so
# //tests/bazel_rules can exercise the pass; the repository is LAZY, so a
# consumer that never builds a target naming `@binaryen//:wasm-opt` never
# downloads it. //bazel/wasm_opt/extensions.bzl has the reasoning.
binaryen = use_extension("//bazel/wasm_opt:extensions.bzl", "binaryen")
use_repo(binaryen, "binaryen")

pub = use_extension("@rules_dart//dart/pub:extensions.bzl", "pub")
pub.from_lock(
    name = "pub_deps",
    lock = "//runtime/dart:pubspec.lock",
    # rules_dart's own lock files share packages with ours; accept the
    # higher version when locks disagree.
    on_version_conflict = "upgrade",
)
use_repo(pub, "pub_deps")
