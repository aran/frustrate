"""The FRB bridge crate, built by rules_rust from checked-in generated code.

FRB's codegen runs by hand, outside the build, and its output
(`src/frb_generated.rs`) is source as far as Bazel is concerned.
"""

load("@rules_rust//rust:defs.bzl", "rust_shared_library", "rust_test")

# crate_universe needs the manifest as a label; the hub in MODULE.bazel names
# it. The hand-written sources are exported so //codegen_action can declare
# them as inputs to the codegen-as-an-action experiment.
exports_files([
    "Cargo.toml",
    "src/lib.rs",
    "src/api/mod.rs",
    "src/api/simple.rs",
])

_SRCS = [
    "src/lib.rs",
    "src/api/mod.rs",
    "src/api/simple.rs",
    # Generated by `flutter_rust_bridge_codegen generate`, run by hand from
    # the directory above. Bazel cannot produce this file (see ../README.md);
    # it is checked in exactly as FRB's own convention prescribes.
    "src/frb_generated.rs",
]

rust_shared_library(
    name = "bazel_frb_bridge",
    srcs = _SRCS,
    edition = "2021",
    visibility = ["//visibility:public"],
    deps = ["@frb_crates//:flutter_rust_bridge"],
)

# The same crate as an rlib, so there is something a rust_test can link and so
# `bazel build` proves the generated code compiles in both crate types.
rust_test(
    name = "bridge_test",
    size = "small",
    srcs = _SRCS,
    crate_name = "bazel_frb_bridge",
    edition = "2021",
    deps = ["@frb_crates//:flutter_rust_bridge"],
)
