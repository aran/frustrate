"""The "can flutter_rust_bridge be built by Bazel?" experiment.

Its own Bazel workspace root, for the same reason e2e/flutter_demo is one:
`bazel_frb` is listed in the repo root's `.bazelignore`, so nothing under it
is visible to `//...` at the root. Run every command in README.md from THIS
directory.

It deliberately does NOT `bazel_dep` on frustrate. The question is what
rules_rust and rules_dart alone can do with FRB's crate, FRB's generated Rust
and FRB's generated Dart, and a frustrate dep would only add noise.

NO .bazelrc, by repo rule: every diagnostic flag is passed on the command
line so that the command is the reproduction.
"""

module(
    name = "bazel_frb_experiment",
    version = "0.0.0",
)

bazel_dep(name = "rules_rust", version = "0.75.0")
bazel_dep(name = "rules_dart", version = "0.10.0")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "bazel_skylib", version = "1.9.2")

rust = use_extension("@rules_rust//rust:extensions.bzl", "rust")
rust.toolchain(
    edition = "2021",
    versions = ["1.99.1"],
)
use_repo(rust, "rust_toolchains")

register_toolchains("@rust_toolchains//:all")

# The FRB crate graph. A hub of its own: hub repos are not re-exported to
# other modules and one hub is one feature-unified graph, so FRB's 60-odd
# crates cannot ride in frustrate's `@frustrate_crates` even if this
# were in the same workspace. `flutter_rust_bridge` is a plain crates.io dependency, so
# crate_universe resolves it exactly like any other.
crate = use_extension("@rules_rust//crate_universe:extensions.bzl", "crate")
crate.from_cargo(
    name = "frb_crates",
    cargo_lockfile = "//:Cargo.lock",
    manifests = [
        "//:Cargo.toml",
        "//bridge:Cargo.toml",
    ],
)
use_repo(crate, "frb_crates")

dart = use_extension("@rules_dart//dart:extensions.bzl", "dart")
dart.toolchain(dart_version = "3.14.1")

# The Dart half: package:flutter_rust_bridge and its transitive pub deps,
# resolved from the same pubspec.lock `dart pub get` wrote.
pub = use_extension("@rules_dart//dart/pub:extensions.bzl", "pub")
pub.from_lock(
    name = "pub_deps",
    lock = "//:pubspec.lock",
)
use_repo(pub, "pub_deps")
