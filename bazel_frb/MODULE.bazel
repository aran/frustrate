use_repo(rust, "rust_toolchains")

register_toolchains("@rust_toolchains//:all")

# The FRB crate graph. A hub of its own: hub repos are not re-exported to
# other modules and one hub is one feature-unified graph, so FRB's 60-odd
# crates cannot ride in frustrate's `@crates` even if this were in the same
# workspace. `flutter_rust_bridge` is a plain crates.io dependency, so
# crate_universe resolves it exactly like any other.
crate = use_extension("@rules_rust//crate_universe:extensions.bzl", "crate")
crate.from_cargo(
    name = "frb_crates",
    cargo_lockfile = "//:Cargo.lock",
    manifests = [
        "//:Cargo.toml",
        "//bridge:Cargo.toml",
    ],
)
use_repo(crate, "frb_crates")

dart = use_extension("@rules_dart//dart:extensions.bzl", "dart")
dart.toolchain(dart_version = "3.13.2")
use_repo(dart, "dart_toolchains")

register_toolchains("@dart_toolchains//:all")

# The Dart half: package:flutter_rust_bridge and its transitive pub deps,
# resolved from the same pubspec.lock `dart pub get` wrote.
pub = use_extension("@rules_dart//dart/pub:extensions.bzl", "pub")
pub.from_lock(
    name = "pub_deps",
    lock = "//:pubspec.lock",
    on_version_conflict = "upgrade",
)
use_repo(pub, "pub_deps")
