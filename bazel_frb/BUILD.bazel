"""Root package: the manifests crate_universe reads, plus the Dart half.

The Dart half is route 3's other side: FRB's generated Dart, checked in and
compiled by rules_dart with no pub and no FRB tooling in the invocation.
"""

load("@rules_dart//dart:defs.bzl", "dart_analysis_config", "dart_analysis_options", "dart_format", "dart_library", "dart_test")

exports_files([
    "Cargo.toml",
    "Cargo.lock",
    "pubspec.yaml",
    "pubspec.lock",
    "flutter_rust_bridge.yaml",
])

dart_library(
    name = "bazel_frb_dart",
    package_name = "bazel_frb_dart",
    srcs = [
        "lib/bazel_frb_dart.dart",
        # Generated by `flutter_rust_bridge_codegen generate`. Checked in,
        # like the Rust half, because Bazel cannot produce it (see README.md).
        "lib/src/api/simple.dart",
        "lib/src/frb_generated.dart",
        "lib/src/frb_generated.io.dart",
        "lib/src/frb_generated.web.dart",
    ],
    # Generated code keeps the generator's formatting.
    tags = ["no-dart-format"],
    visibility = ["//visibility:public"],
    deps = ["@pub_deps//:flutter_rust_bridge"],
)

# The end-to-end proof: the Bazel-built cdylib loaded by the Bazel-built
# bindings. `data` is the Rust artifact; nothing in this test reads the
# source tree.
dart_test(
    name = "smoke_test",
    size = "small",
    data = ["//bridge:bazel_frb_bridge"],
    main = "test/smoke_test.dart",
    deps = [
        ":bazel_frb_dart",
        "@pub_deps//:flutter_rust_bridge",
        "@pub_deps//:test",
        "@rules_dart//dart/runfiles",
    ],
)

# Every `analysis_options.yaml` here, for the `dart_analyze` aspect `.bazelrc`
# enables under `bazel test`.
dart_analysis_options(
    name = "analysis_options",
    src = "analysis_options.yaml",
)

dart_analysis_config(
    name = "analysis_config",
    options = [":analysis_options"],
)

dart_format(name = "format")
